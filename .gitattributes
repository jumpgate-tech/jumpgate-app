# .gitattributes — LF everywhere, so Windows checkouts (core.autocrlf=true on
# the runners) compare byte-for-byte with golden strings and testdata.
* text=auto eol=lf
*.png binary
*.ico binary
*.gz binary

# Golden TUI frames compare byte for byte on every OS. Listed after the
# catch-all so the explicit "text" (no auto-detection) wins for them.
*.golden text eol=lf
