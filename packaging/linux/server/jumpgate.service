[Unit]
Description=jumpgate controller
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/jumpgate serve --no-open --system
User=jumpgate-ctl
Group=jumpgate-ctl
SupplementaryGroups=jumpgate-admin
Environment=HOME=/var/lib/jumpgate-ctl
StateDirectory=jumpgate-ctl
StateDirectoryMode=0700
RuntimeDirectory=jumpgate-ctl
RuntimeDirectoryMode=0750
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
